# Ignore everything by default
*

# Allow tracking of .gitignore itself
!.gitignore

# Explicitly whitelist requested files
!main.nf
!nextflow.config
!params.yaml
!/supplementary.json

# Explicitly whitelist the modules folder and all its contents
!modules/
!modules/**

# Explicitly whitelist the bin folder
!bin/
!bin/**

# Explicitly whitelist the assets folder (NO_WHITELIST placeholder etc.)
!assets/
!assets/**

# Never track Python cache, even inside whitelisted folders
__pycache__/
*.pyc
