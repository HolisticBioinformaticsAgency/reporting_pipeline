// ----------------- Caps -----------------
params {
  max_memory     = 330.GB
  max_cpus       = 48
  max_time       = 7.d
  pytmb_eff_size = null  // set in params.yaml; declared here so Nextflow resolves it at compile time
}

// ----------------- Singularity/Apptainer -----------------
singularity {
  enabled    = true
  autoMounts = true
  cacheDir   = "/fs04/scratch2/vh83/liem/projects/molbi_pipeline/containers"
  runOptions = '-B /scratch -B /projects -B /fs04'
}

// ----------------- Slurm executor tuning -----------------
executor {
  queueSize         = 200
  pollInterval      = '30 sec'
  queueStatInterval = '10m'
}

// ----------------- Process defaults -----------------
process {
  executor      = 'slurm'
  stageInMode   = 'symlink'
  cache         = 'lenient'
  beforeScript  = 'module load singularity'
  errorStrategy = 'retry'
  maxRetries    = 3
  scratch       = true

  cpus   = { 2 }
  memory = { [ (task.attempt == 1) ? 8.GB  : (8.GB  + (task.attempt * 4.GB)),  params.max_memory ].min() }
  time   = { [ (task.attempt == 1) ? 1.h   : (1.h   + (task.attempt * 0.5.h)), params.max_time   ].min() }

  clusterOptions = { task.time <= 4.h ? '--partition=genomics --qos=genomics' : '--partition=comp --qos=normal' }

  withName: 'VEP' {
    cpus   = { 4 }
    memory = { [ (task.attempt == 1) ? 16.GB : (16.GB + (task.attempt * 8.GB)), params.max_memory ].min() }
    time   = { [ (task.attempt == 1) ? 2.h   : (2.h   + (task.attempt * 1.h)),  params.max_time   ].min() }
  }

  withName: 'CLINVAR' {
    memory = { [ (task.attempt == 1) ? 16.GB : (16.GB + (task.attempt * 8.GB)), params.max_memory ].min() }
    time   = { [ (task.attempt == 1) ? 2.h   : (2.h   + (task.attempt * 1.h)),  params.max_time   ].min() }
  }

  // gnomAD is ~14.6GB uncompressed. SnpSift annotate (even with -sorted -
  // confirmed empirically that -sorted still builds a full in-memory
  // VcfIndex/VcfIndexDataChromo, it does NOT avoid this) loads the whole
  // database into memory. Reproduced a genuine OutOfMemoryError at the
  // container's default -Xmx1g heap; -Xmx36g/48G task memory here is a
  // reasoned estimate sized off the data volume, not an empirically-
  // confirmed minimum - ad-hoc interactive testing couldn't observe the
  // indexing step complete within any timeout short enough to be practical
  // (it's slow, not just memory-hungry). Validate against a real run and
  // adjust if it still OOMs or runs long.
  withName: 'GNOMAD' {
    memory = { [ (task.attempt == 1) ? 48.GB : (48.GB + (task.attempt * 16.GB)), params.max_memory ].min() }
    time   = { [ (task.attempt == 1) ? 4.h   : (4.h   + (task.attempt * 2.h)),   params.max_time   ].min() }
  }

  // dbNSFP is ~50GB; a default -Xmx1g heap OOM'd silently partway through the
  // file in production (see modules/vcf_annotate.nf DBNSFP comment) - fixed
  // there with -Xmx12g, which needs >=16G task memory to not just hit the
  // cgroup ceiling instead of the JVM heap ceiling. 16G/4h matches the actual
  // successful production run (run_dbnsfp_batch.sh: --mem=16G, --time=04:00:00).
  withName: 'DBNSFP' {
    memory = { [ (task.attempt == 1) ? 16.GB : (16.GB + (task.attempt * 8.GB)), params.max_memory ].min() }
    time   = { [ (task.attempt == 1) ? 4.h   : (4.h   + (task.attempt * 2.h)),  params.max_time   ].min() }
  }

  // CGEN_REPORT (2026-10-14): cohort_run.py's ingest/annotate load every variant in the
  // gated VCF (tens of thousands, not just the reportable subset) into pydantic models -
  // 24G confirmed needed by hand (sbatch) for a single sample; OOM'd at the 8G default.
  // No container, so the global `beforeScript = 'module load singularity'` is overridden
  // in the module itself (adds R/4.4.0-mkl + samtools/1.19.3, keeps singularity for the
  // bcftools_bin wrapper scripts cohort_run.py shells out to).
  // maxForks=1 (2026-10-15): classify opens cohort_run.py's shared COSMIC CMC sqlite
  // (run_config_m3.json's cmc_sqlite) read-only but SQLite's locking still trips on a
  // shared filesystem under concurrent access - confirmed on the real cohort, 3 patients'
  // CGEN_REPORT running at once all hit "sqlite3.OperationalError: database is locked"
  // in classify. Serialises this one process across the whole run instead.
  withName: 'CGEN_REPORT' {
    cpus     = { 2 }
    memory   = { [ (task.attempt == 1) ? 24.GB : (24.GB + (task.attempt * 12.GB)), params.max_memory ].min() }
    time     = { [ (task.attempt == 1) ? 2.h   : (2.h   + (task.attempt * 1.h)),   params.max_time   ].min() }
    maxForks = 1
  }
}

// ----------------- Run records (CGen, 2026-10-09) -----------------
// Nextflow's own trace, report and timeline land in <outdir>/pipeline_info/ with the run's start time in the name.
// A bare `def` can no longer be mixed with config blocks on this Nextflow version
// ("Variable declarations cannot be mixed with config statements") - params.* assignment
// is itself a valid config statement, so it carries the shared timestamp instead (fix, 2026-10-12).
params.run_stamp = new java.util.Date().format('yyyyMMdd_HHmmss')
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${params.run_stamp}.txt" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${params.run_stamp}.html" }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${params.run_stamp}.html" }
// Moved here from main.nf (2026-10-12 fix, see main.nf's own note) - this is the
// run summary for the copy-number record and any report built on these outputs
// (CGen, 2026-10-09): code version, Nextflow version, dates, outcome, command line,
// every parameter.
workflow.onComplete = {
    def rev = workflow.commitId ?: "git -C ${projectDir} rev-parse HEAD".execute().text.trim()
    def dirty = workflow.commitId ? "" : "git -C ${projectDir} status --porcelain".execute().text.trim()
    def info = [revision: rev, uncommitted_changes: dirty ? true : false, nextflow: nextflow.version.toString(),
                started: workflow.start.toString(), completed: workflow.complete.toString(), success: workflow.success,
                command: workflow.commandLine, params: params]
    // Nextflow's own `file()` helper isn't available inside a config-file closure
    // (2026-10-12 fix: "Unknown method invocation `file` on LinkedHashMap type") -
    // plain Groovy java.io.File works fine here instead.
    new File("${params.outdir}/pipeline_info").mkdirs()
    new File("${params.outdir}/pipeline_info/run_info_${workflow.start.format('yyyyMMdd_HHmmss')}.json").text =
        groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(info))
}
